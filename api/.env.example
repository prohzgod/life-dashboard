# Neon: the pooled connection string, with sslmode=require
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Files one account may store
USER_FILE_QUOTA_BYTES=1000000000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
PORT=3000
# Proxies in front of the API: Vercel's rewrite and Render's load balancer
TRUST_PROXY_HOPS=2
# Sign-in and sign-up attempts per person per minute
AUTH_RATE_LIMIT=10
# Local testing only: pglite and memory run without Neon or R2
# DB_DRIVER=pglite
# FILES_DRIVER=memory
